{
  "name": "Appointment reminders (Bot Playbook template)",
  "nodes": [
    {
      "id": "7d2e2a9f-0001-4c5a-9a01-5b0b0c0d0001",
      "name": "Every day at 10 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 10
            }
          ]
        }
      }
    },
    {
      "id": "7d2e2a9f-0002-4c5a-9a01-5b0b0c0d0002",
      "name": "Tomorrow's bookings",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        220,
        0
      ],
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "returnAll": true,
        "timeMin": "={{ $today.plus({ days: 1 }) }}",
        "timeMax": "={{ $today.plus({ days: 2 }) }}",
        "options": {
          "timeZone": {
            "__rl": true,
            "mode": "list",
            "value": "America/New_York",
            "cachedResultName": "America/New_York"
          }
        }
      }
    },
    {
      "id": "7d2e2a9f-0003-4c5a-9a01-5b0b0c0d0003",
      "name": "Said yes to reminders",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b5c8d3e2-0001-4e1f-8a2b-000000000001",
              "leftValue": "={{ $json.description }}",
              "rightValue": "Reminder: yes",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "7d2e2a9f-0004-4c5a-9a01-5b0b0c0d0004",
      "name": "Reminder details",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        660,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c6d9e4f3-0001-4e1f-8a2b-000000000001",
              "name": "name",
              "type": "string",
              "value": "={{ $json.description.split(' · ')[0].replace('Booked on WhatsApp by ', '') }}"
            },
            {
              "id": "c6d9e4f3-0002-4e1f-8a2b-000000000002",
              "name": "phone",
              "type": "string",
              "value": "={{ $json.description.split(' · ')[1] }}"
            },
            {
              "id": "c6d9e4f3-0003-4e1f-8a2b-000000000003",
              "name": "service",
              "type": "string",
              "value": "={{ $json.summary.split(' · ')[0] }}"
            },
            {
              "id": "c6d9e4f3-0004-4e1f-8a2b-000000000004",
              "name": "time",
              "type": "string",
              "value": "={{ DateTime.fromISO($json.start.dateTime).setZone('America/New_York').toFormat('h:mm a') }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "7d2e2a9f-0005-4c5a-9a01-5b0b0c0d0005",
      "name": "Send reminder",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ],
      "webhookId": "7d2e2a9f-0105-4c5a-9a01-5b0b0c0d0105",
      "parameters": {
        "operation": "sendTemplate",
        "phoneNumberId": "",
        "recipientPhoneNumber": "={{ $json.phone }}",
        "template": "appointment_reminder|en",
        "components": {
          "component": [
            {
              "type": "body",
              "bodyParameters": {
                "parameter": [
                  {
                    "type": "text",
                    "text": "={{ $json.name }}"
                  },
                  {
                    "type": "text",
                    "text": "={{ $json.service.toLowerCase() }}"
                  },
                  {
                    "type": "text",
                    "text": "={{ $json.time }}"
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Every day at 10 AM": {
      "main": [
        [
          {
            "node": "Tomorrow's bookings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tomorrow's bookings": {
      "main": [
        [
          {
