          }
        ]
      ]
    },
    "Said yes to reminders": {
      "main": [
        [
          {
            "node": "Reminder details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reminder details": {
      "main": [
        [
          {
            "node": "Send reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/New_York"
  },
