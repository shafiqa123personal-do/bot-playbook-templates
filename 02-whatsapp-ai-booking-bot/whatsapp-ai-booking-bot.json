{
  "name": "WhatsApp AI Booking Bot (Bot Playbook template)",
  "nodes": [
    {
      "id": "6c1d1f8e-0001-4c5a-9a01-5b0b0c0d0001",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "webhookId": "6c1d1f8e-0101-4c5a-9a01-5b0b0c0d0101",
      "parameters": {
        "updates": [
          "messages"
        ],
        "options": {}
      }
    },
    {
      "id": "6c1d1f8e-0002-4c5a-9a01-5b0b0c0d0002",
      "name": "Only text messages",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "a4b7c2d1-0001-4e1f-8a2b-000000000001",
              "leftValue": "={{ $json.messages?.[0]?.text?.body }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6c1d1f8e-0003-4c5a-9a01-5b0b0c0d0003",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        520,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.messages[0].text.body }}",
        "options": {
          "systemMessage": "=Today is {{ $now.toFormat('cccc d LLLL yyyy, h:mm a') }}, time zone UTC{{ $now.toFormat('ZZ') }}. Always use this time zone in tool times.\nYou are the WhatsApp assistant for Bella's Hair Studio. Answer only using the information below. Keep answers short and friendly. If you don't know the answer, say: \"Good question! I'll ask the team and they'll reply soon.\" Never make up prices or times.\nHours: Monday to Friday 9 AM to 7 PM, Saturday 9 AM to 5 PM, Sunday closed. Address: 142 Maple Street, Springfield. Prices: women's haircut $45, men's haircut $30, kids' haircut $20, colouring $80 to $150, blowout $35.\nBooking rules: Services and how long they take: women's haircut 45 min, men's haircut 30 min, kids' haircut 30 min, colouring 2 hours, blowout 45 min. Only book inside opening hours, and the appointment must end before closing. Before offering a time, use Check calendar. Offer at most two free times. Before using Book appointment, repeat the service, day and time and wait for the customer to say yes. Never book in the past. If the customer wants to cancel or move a booking, say the team will reply soon. Write plain text, no markdown symbols."
        }
      }
    },
    {
      "id": "6c1d1f8e-0004-4c5a-9a01-5b0b0c0d0004",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        440,
        240
      ],
      "parameters": {
        "modelName": "models/gemini-3.5-flash",
        "options": {}
      }
    },
    {
      "id": "6c1d1f8e-0005-4c5a-9a01-5b0b0c0d0005",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        620,
        240
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('WhatsApp Trigger').item.json.contacts[0].wa_id }}",
        "contextWindowLength": 10
      }
    },
    {
      "id": "6c1d1f8e-0006-4c5a-9a01-5b0b0c0d0006",
      "name": "Send reply",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        900,
        0
      ],
      "webhookId": "6c1d1f8e-0106-4c5a-9a01-5b0b0c0d0106",
      "parameters": {
        "operation": "send",
        "phoneNumberId": "",
        "recipientPhoneNumber": "={{ $('WhatsApp Trigger').item.json.messages[0].from }}",
        "textBody": "={{ $json.output }}",
        "additionalFields": {}
      }
    },
    {
      "id": "6c1d1f8e-0007-4c5a-9a01-5b0b0c0d0007",
      "name": "Save lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        520,
        -260
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $now.toFormat('yyyy-MM-dd HH:mm') }}",
            "Name": "={{ $json.contacts[0].profile.name }}",
            "Phone": "={{ $json.contacts[0].wa_id }}",
            "Message": "={{ $json.messages[0].text.body }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "Date",
              "displayName": "Date",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Name",
              "displayName": "Name",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Phone",
              "displayName": "Phone",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Message",
              "displayName": "Message",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "6c1d1f8e-0008-4c5a-9a01-5b0b0c0d0008",
      "name": "Check calendar",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        800,
        240
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Use this to see which times are already booked on a day. Always check before offering or booking a time.",
        "resource": "calendar",
        "operation": "availability",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "timeMin": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Start_Time', ``, 'string') }}",
        "timeMax": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('End_Time', ``, 'string') }}",
        "options": {
          "outputFormat": "bookedSlots",
          "timezone": {
            "__rl": true,
            "mode": "list",
            "value": "America/New_York",
            "cachedResultName": "America/New_York"
          }
        }
      }
    },
    {
      "id": "6c1d1f8e-0009-4c5a-9a01-5b0b0c0d0009",
      "name": "Book appointment",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        980,
        240
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Books one appointment. Only use it after the customer has confirmed the service, day and time.",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "start": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Start', ``, 'string') }}",
        "end": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('End', ``, 'string') }}",
        "additionalFields": {
          "summary": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Summary', ``, 'string') }}",
          "description": "=Booked on WhatsApp by {{ $('WhatsApp Trigger').item.json.contacts[0].profile.name }} · {{ $('WhatsApp Trigger').item.json.contacts[0].wa_id }}"
        }
      }
    }
  ],
